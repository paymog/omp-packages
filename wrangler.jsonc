{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omp-packages",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": { "directory": "./public" },
  "cache": { "enabled": true },
  "routes": [{ "pattern": "omppackages.com", "custom_domain": true }],
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omp-packages",
      "database_id": "52dc0d35-f42b-4c58-8348-19114b2b59df",
      "migrations_dir": "migrations"
    }
  ]
}
